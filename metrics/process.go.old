package metrics

// ========================================================================
//  OPTIMIZED PROCESS SCANNER
// ========================================================================
//
// The original process.go reads TWO files per PID every 2 seconds:
//   /proc/<pid>/stat   (~200 bytes, needed for CPU ticks + name)
//   /proc/<pid>/status (~2KB, 50+ lines, scanned for one field: VmRSS)
//
// On a server with 200 processes, that's 400 ReadFile calls per tick.
//
// This version:
//   1. Replaces /proc/<pid>/status with /proc/<pid>/statm — a single
//      line of 7 numbers where field[1] is RSS in pages.  ~20 bytes
//      instead of ~2KB.  Eliminates the line-by-line scan entirely.
//
//   2. Caches MemTotal from /proc/meminfo — it never changes.
//
//   3. Uses os.ReadFile once for each file (no change), but reads
//      ~95% less data per PID.
//
// Net effect: ~50% fewer bytes read from /proc per tick.

import (
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"strconv"
	"strings"
	"sync"
	"time"
)

// ProcessInfo holds the data we display for a single process.
type ProcessInfo struct {
	PID        int
	Name       string
	CPUPercent float64
	MemMB      float64
	MemPercent float64
}

// prevProcCPU stores the last snapshot of per-PID CPU ticks so we can
// compute deltas on the next collection cycle.
var (
	prevProcCPU      map[int]procCPUSnap
	prevProcCPUMutex sync.Mutex
	prevProcTime     time.Time
)

type procCPUSnap struct {
	utime uint64
	stime uint64
}

// Cached total memory — read once, never changes.
var (
	cachedTotalMemKB uint64
	totalMemOnce     sync.Once
)

// System page size — read once at startup.
var pageSize = uint64(os.Getpagesize())

// GetTopProcesses scans /proc for all processes, computes CPU% via
// tick deltas, and returns two slices sorted by CPU and memory.
func GetTopProcesses(n int) (byCPU []ProcessInfo, byMem []ProcessInfo, err error) {
	entries, err := os.ReadDir("/proc")
	if err != nil {
		return nil, nil, fmt.Errorf("reading /proc: %w", err)
	}

	// Cache MemTotal — it never changes at runtime.
	totalMemOnce.Do(func() {
		cachedTotalMemKB = readTotalMemKB()
	})

	const clockTicks = 100.0
	now := time.Now()
	current := make(map[int]procCPUSnap)
	var procs []ProcessInfo

	for _, entry := range entries {
		pid, err := strconv.Atoi(entry.Name())
		if err != nil {
			continue
		}

		info, snap, ok := readProcessInfoFast(pid, cachedTotalMemKB)
		if !ok {
			continue
		}

		current[pid] = snap
		procs = append(procs, info)
	}

	// Compute CPU% from deltas.
	prevProcCPUMutex.Lock()
	elapsed := now.Sub(prevProcTime).Seconds()

	if prevProcCPU != nil && elapsed > 0 {
		for i := range procs {
			pid := procs[i].PID
			prev, ok := prevProcCPU[pid]
			if !ok {
				continue
			}
			cur := current[pid]
			totalDelta := float64((cur.utime - prev.utime) + (cur.stime - prev.stime))
			procs[i].CPUPercent = (totalDelta / clockTicks / elapsed) * 100.0
		}
	}

	prevProcCPU = current
	prevProcTime = now
	prevProcCPUMutex.Unlock()

	// Sort by CPU.
	sort.Slice(procs, func(i, j int) bool {
		return procs[i].CPUPercent > procs[j].CPUPercent
	})
	byCPU = topN(procs, n)

	// Sort by Memory.
	sort.Slice(procs, func(i, j int) bool {
		return procs[i].MemPercent > procs[j].MemPercent
	})
	byMem = topN(procs, n)

	return byCPU, byMem, nil
}

// readProcessInfoFast reads /proc/<pid>/stat for CPU + name, and
// /proc/<pid>/statm for RSS.
//
// /proc/<pid>/statm is a single line: "size resident shared text lib data dt"
// where 'resident' (field 1) is RSS in pages.  This replaces the old
// approach of reading the multi-line /proc/<pid>/status and scanning
// 50+ lines for "VmRSS:".
func readProcessInfoFast(pid int, totalMemKB uint64) (ProcessInfo, procCPUSnap, bool) {
	pidDir := filepath.Join("/proc", strconv.Itoa(pid))

	// ── /proc/<pid>/stat ───────────────────────────────────────
	statData, err := os.ReadFile(filepath.Join(pidDir, "stat"))
	if err != nil {
		return ProcessInfo{}, procCPUSnap{}, false
	}

	statStr := string(statData)
	nameStart := strings.IndexByte(statStr, '(')
	nameEnd := strings.LastIndexByte(statStr, ')')
	if nameStart < 0 || nameEnd < 0 || nameEnd <= nameStart {
		return ProcessInfo{}, procCPUSnap{}, false
	}
	name := statStr[nameStart+1 : nameEnd]

	rest := strings.Fields(statStr[nameEnd+2:])
	if len(rest) < 13 {
		return ProcessInfo{}, procCPUSnap{}, false
	}
	utime, _ := strconv.ParseUint(rest[11], 10, 64)
	stime, _ := strconv.ParseUint(rest[12], 10, 64)

	// ── /proc/<pid>/statm — single line, ~20 bytes ─────────────
	// Format: size resident shared text lib data dt
	// We only need field 1 (resident) = RSS in pages.
	var rssKB uint64
	if statmData, err := os.ReadFile(filepath.Join(pidDir, "statm")); err == nil {
		fields := strings.Fields(string(statmData))
		if len(fields) >= 2 {
			rssPages, _ := strconv.ParseUint(fields[1], 10, 64)
			rssKB = rssPages * pageSize / 1024
		}
	}

	var memPct float64
	if totalMemKB > 0 {
		memPct = float64(rssKB) / float64(totalMemKB) * 100.0
	}

	info := ProcessInfo{
		PID:        pid,
		Name:       name,
		MemMB:      float64(rssKB) / 1024.0,
		MemPercent: memPct,
	}
	snap := procCPUSnap{utime: utime, stime: stime}
	return info, snap, true
}

// readTotalMemKB reads MemTotal from /proc/meminfo.  Called once and
// cached.
func readTotalMemKB() uint64 {
	data, err := os.ReadFile("/proc/meminfo")
	if err != nil {
		return 0
	}
	for _, line := range strings.Split(string(data), "\n") {
		if strings.HasPrefix(line, "MemTotal:") {
			parts := strings.Fields(line)
			if len(parts) >= 2 {
				val, _ := strconv.ParseUint(parts[1], 10, 64)
				return val
			}
		}
	}
	return 0
}

func topN(procs []ProcessInfo, n int) []ProcessInfo {
	if len(procs) <= n {
		result := make([]ProcessInfo, len(procs))
		copy(result, procs)
		return result
	}
	result := make([]ProcessInfo, n)
	copy(result, procs[:n])
	return result
}
